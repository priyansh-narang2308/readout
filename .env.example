# Client-side Flagsmith environment key (public by Flagsmith's design, but never committed).
# Local and preview builds: the Development key. Production deploy: the Production key.
VITE_FLAGSMITH_ENV_KEY=
# "development" or "production". Drives the env tag, debug panel and logging.
VITE_FLAGSMITH_ENV_NAME=development
# Public GitHub repository for the footer link, e.g. https://github.com/<owner>/<repo>. Leave empty until it exists.
VITE_REPO_URL=
