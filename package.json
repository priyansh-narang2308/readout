{
  "name": "readout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:browser": "node dev/browser-check.mjs",
    "check:arms": "node dev/check-arm-geometry.mjs",
    "check:browser:prod": "TARGET=prod node dev/browser-check.mjs",
    "links": "node scripts/links.mjs",
    "impact": "node scripts/impact.mjs",
    "check:frozen": "node scripts/check-frozen.mjs",
    "check:release": "node scripts/check-frozen.mjs --require",
    "check:all": "npm run typecheck && npm test && npm run check:isolation && npm run check:secrets && npm run check:frozen && npm run build && npm run check:browser && npm run check:browser:prod && npm run check:arms",
    "dev:synthetic": "node scripts/dev-synthetic.mjs"
  },
  "dependencies": {
    "@flagsmith/flagsmith": "12.4.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.2",
    "jsdom": "25.0.1",
    "playwright-core": "1.49.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
